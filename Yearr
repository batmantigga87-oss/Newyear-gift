<!DOCTYPE html>
<html>
<head>
<title>New Year Gift 🎆</title>
<style>
body{
    margin:0;
    height:100vh;
    background:black;
    overflow:hidden;
    display:flex;
    align-items:center;
    justify-content:center;
    flex-direction:column;
    color:white;
    font-family: 'Arial', sans-serif;
}

h1{
    font-size:2.5em;
    margin-bottom:20px;
    animation: glow 2s infinite;
}

button{
    padding:15px 30px;
    font-size:1.2em;
    border:none;
    border-radius:30px;
    background:#ff4d6d;
    color:white;
    cursor:pointer;
}

@keyframes glow{
    0%{text-shadow:0 0 10px red;}
    50%{text-shadow:0 0 20px gold;}
    100%{text-shadow:0 0 10px red;}
}

.firework{
    position:absolute;
    width:6px;
    height:6px;
    background:white;
    border-radius:50%;
    animation: explode 2s infinite;
}

@keyframes explode{
    0%{transform:scale(0);opacity:1;}
    100%{transform:scale(30);opacity:0;}
}
</style>
</head>
<body>

<h1>🎆 Happy New Year 🎆</h1>
<button onclick="location.href='page2.html'">Tap to Open Your Gift 💝</button>

<script>
setInterval(()=>{
    let f=document.createElement("div");
    f.className="firework";
    f.style.left=Math.random()*100+"vw";
    f.style.top=Math.random()*100+"vh";
    document.body.appendChild(f);
    setTimeout(()=>f.remove(),2000);
},300);
</script>

</body>
</html>
